# SPA fallback. Every SPA route also exists as <route>/index.html, so pages
# work even if this file is missing or rewrites are disabled.
ErrorDocument 404 /index.html
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
